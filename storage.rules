rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lectura pública de imágenes/layouts para la web
    match /{allPaths=**} {
      allow read: if true;

      // Escritura solo para usuarios autenticados y archivos de imagen
      allow write: if request.auth != null
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Borrar: solo el Administrador de Plataforma. La regla de arriba exige
      // request.resource, que en un borrado es null, así que hasta ahora
      // ninguna limpieza desde la web funcionaba (quedaban imágenes
      // huérfanas al cambiar el avatar de un equipo o la imagen de un
      // circuito).
      allow delete: if request.auth != null
        && request.auth.token.platformOwner == true;
    }
  }
}
