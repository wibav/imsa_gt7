rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Reglas de seguridad — Fase 0 (blindaje) + Fase 1 (orgId) + Fase 2 (roles
// org-scoped, ADR-006 resuelto).
//
// Reemplaza la ausencia total de reglas (antes, la única protección era
// JavaScript en el cliente: ADMIN_EMAILS hardcodeado). La fuente de verdad de
// los roles es el Custom Claim del token de Firebase Auth:
//   { platformOwner?: true, orgs?: { [orgId]: role } }
//   role ∈ 'organizador' | 'director_liga' | 'comisario'
// asignado exclusivamente por la Cloud Function `manage_user_role` (Admin
// SDK) — nunca escrito directo por el cliente.
//
// Jerarquía dentro de una organización: organizador > director_liga >
// comisario (un rol superior incluye los permisos de los inferiores en esa
// misma organización). `platformOwner` es un rol de plataforma, por encima
// de todas las organizaciones, independiente de `orgs`.
//
// Ver: Notas/Proyectos/GT7 Championships/02-ESPECIFICACIONES.md (SPEC-2, SPEC-4, SPEC-5)
//      Notas/Proyectos/GT7 Championships/ADR/ADR-001-modelo-datos-multi-tenant.md
//      Notas/Proyectos/GT7 Championships/ADR/ADR-003-roles-permisos.md
//      Notas/Proyectos/GT7 Championships/ADR/ADR-006-diferir-claims-por-organizacion.md
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador de Plataforma (dueño de trenkit) — por encima de todas
    // las organizaciones. Solo se otorga una vez, vía script, nunca por el
    // flujo normal de gestión de roles.
    function isPlatformOwner() {
      return isSignedIn() && request.auth.token.platformOwner == true;
    }

    function orgRole(orgId) {
      return isSignedIn()
        ? request.auth.token.get('orgs', {}).get(orgId, null)
        : null;
    }

    // director_liga u organizador de esa organización específica.
    function isOrgAdmin(orgId) {
      let role = orgRole(orgId);
      return role == 'organizador' || role == 'director_liga';
    }

    // comisario, director_liga, u organizador de esa organización específica
    // (un rol superior siempre incluye los permisos de comisario).
    function isOrgComisario(orgId) {
      let role = orgRole(orgId);
      return role == 'organizador' || role == 'director_liga' || role == 'comisario';
    }

    // orgId del documento padre championships/{champId}, para las
    // subcolecciones que heredan su aislamiento (no llevan orgId propio).
    function parentChampOrgId(champId) {
      return get(/databases/$(database)/documents/championships/$(champId)).data.orgId;
    }

    // orgId del documento padre events/{eventId}.
    function parentEventOrgId(eventId) {
      return parentEventDoc(eventId).orgId;
    }

    function parentEventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function onlyAffects(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Límites de plan (SPEC-6 / docs/PLAN_MONETIZACION.md §1.4) ────────
    // `organizations/{orgId}.limits`/`plan`/`championshipCredits` son la
    // fuente de verdad. Defaults conservadores si faltan (orgs antiguas sin
    // el campo): plan 'pro' (sin restricción) y sin límite de pilotos, para
    // no bloquear datos existentes que aún no tengan estos campos.
    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    // Modelo de "lotes" prepagados (reemplaza la suscripción recurrente,
    // ADR-007): cada organización tiene un saldo de `championshipCredits` —
    // se descuenta 1 por cada campeonato/evento creado (Cloud Function, ver
    // functions/main.py) y solo se recarga comprando otro lote. El plan
    // Free arranca con 1 crédito (su prueba única). `billingExempt` (GT7 ESP,
    // orgs de prueba internas) se salta el conteo por completo.
    function canCreateInOrg(orgId) {
      return orgDoc(orgId).get('billingExempt', false) == true
        || orgDoc(orgId).get('championshipCredits', 0) > 0;
    }

    // null/ausente = sin límite (planes de pago hoy no tienen tope real).
    function withinDriverLimit(orgId, count) {
      let maxDrivers = orgDoc(orgId).get('limits', {}).get('maxDrivers', null);
      return maxDrivers == null || count <= maxDrivers;
    }

    // ── championships/{id} ───────────────────────────────────────────────
    // Documento principal: nombre, categorías, settings, drivers[],
    // registrations[], carUsageTracking, preQualy, divisionsConfig, etc.
    // Lectura pública (clasificaciones/calendario son páginas públicas).
    // Escritura: director_liga/organizador DE ESA ORGANIZACIÓN específica.
    // Excepción: inscripción pública (RegistrationForm) solo puede tocar
    // `registrations` y, si el campeonato es de auto-aprobación,
    // `drivers` en la misma escritura (RegistrationForm agrega el piloto/
    // equipo recién inscrito ahí) — nunca settings, pointsSystem, etc.
    match /championships/{champId} {
      allow read: if true;
      // canCreateInOrg(): plan Free ya consumido su único uso, denegado.
      allow create: if isOrgAdmin(request.resource.data.orgId) && canCreateInOrg(request.resource.data.orgId);
      // orgId es inmutable una vez creado. La inscripción pública además
      // debe respetar el límite de pilotos del plan (ej. 15 en Free), y
      // `drivers` solo puede crecer (nunca reducirse) por esta vía, para
      // que un registrante anónimo no pueda vaciar el roster de nadie.
      allow update: if (isOrgAdmin(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId)
        || (
          onlyAffects(['registrations', 'drivers'])
          && withinDriverLimit(resource.data.orgId, request.resource.data.registrations.size())
          && request.resource.data.drivers.size() >= resource.data.drivers.size()
        );
      allow delete: if isOrgAdmin(resource.data.orgId);

      // Equipos, pistas, divisiones, eventos internos: heredan el orgId del
      // campeonato padre — gestión exclusiva de director_liga/organizador
      // de esa organización.
      match /teams/{teamId} {
        allow read: if true;
        allow write: if isOrgAdmin(parentChampOrgId(champId));
      }
      match /tracks/{trackId} {
        allow read: if true;
        allow write: if isOrgAdmin(parentChampOrgId(champId));
      }
      match /divisions/{divId} {
        allow read: if true;
        allow write: if isOrgAdmin(parentChampOrgId(champId));
      }
      match /events/{subEventId} {
        allow read: if true;
        allow write: if isOrgAdmin(parentChampOrgId(champId));
      }

      // Sanciones: solo comisario+ de esa organización (se crean desde el
      // panel admin, nunca por un piloto).
      match /penalties/{penaltyId} {
        allow read: if true;
        allow write: if isOrgComisario(parentChampOrgId(champId));
      }
      // Reclamaciones: cualquier piloto reporta un incidente sin sesión
      // iniciada (ClaimForm.js, "Reportar Incidente") — a diferencia de
      // penalties, `create` debe estar abierta al público. Lo único que se
      // protege es que nadie pueda crear un reclamo ya "resuelto" de
      // entrada (status/resolvedBy/penaltyId) — eso es exclusivo de un
      // comisario+ vía update/delete, igual que antes.
      match /claims/{claimId} {
        allow read: if true;
        allow create: if request.resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.get('resolvedBy', '') in [null, '']
          && request.resource.data.get('penaltyId', null) == null;
        allow update, delete: if isOrgComisario(parentChampOrgId(champId));
      }
    }

    // ── events/{id} (eventos únicos, no ligados a un campeonato) ─────────
    // Lectura pública. Escritura: director_liga/organizador de esa org.
    // Excepción: el flujo público de inscripción actualiza `participantCount`
    // (contador legacy, mostrado en las tarjetas de evento) y `waitlistCount`
    // más `updatedAt` en el doc principal, además de crear en las
    // subcolecciones `participants`/`waitlist` (sin sesión iniciada).
    match /events/{eventId} {
      allow read: if true;
      allow create: if isOrgAdmin(request.resource.data.orgId) && canCreateInOrg(request.resource.data.orgId);
      allow update: if (isOrgAdmin(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId)
        || onlyAffects(['participantCount', 'waitlistCount', 'updatedAt']);
      allow delete: if isOrgAdmin(resource.data.orgId);

      // `participantsCount` en el doc padre es mantenido por una Cloud
      // Function (Admin SDK, ignora estas reglas) al crear/borrar un
      // participante — se usa aquí solo para topar el límite de pilotos
      // del plan al momento de la inscripción pública.
      match /participants/{participantId} {
        allow read: if true;
        allow create: if withinDriverLimit(parentEventOrgId(eventId), parentEventDoc(eventId).get('participantsCount', 0) + 1);
        allow update, delete: if isOrgAdmin(parentEventOrgId(eventId));
      }
      match /waitlist/{entryId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isOrgAdmin(parentEventOrgId(eventId));
      }
      match /results/{resultId} {
        allow read: if true;
        allow write: if isOrgAdmin(parentEventOrgId(eventId));
      }
      match /rounds/{roundId} {
        allow read: if true;
        allow write: if isOrgAdmin(parentEventOrgId(eventId));
      }
    }

    // ── teams/{id} (catálogo raíz, scopeado por orgId) ───────────────────
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update: if isOrgAdmin(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // ── tracks/{id} (catálogo GLOBAL, compartido entre organizaciones) ───
    // No lleva orgId a propósito (ver 02-ESPECIFICACIONES.md SPEC-2): son
    // imágenes/layouts de circuitos reales de GT7, reutilizables por
    // cualquier organización. Gestión exclusiva del Administrador de
    // Plataforma (petición explícita de producto: es un recurso compartido
    // por todas las ligas, no de una organización en particular).
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    // ── equipment/{id} (catálogo GLOBAL, "Equipamiento recomendado") ─────
    // No lleva orgId: es contenido editorial (afiliación Amazon) del propio
    // dueño de la plataforma, no un recurso de ninguna organización.
    // Lectura pública; escritura exclusiva del Administrador de Plataforma
    // (petición explícita de producto: "solo administrado por mi usuario").
    match /equipment/{itemId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    // ── organizations/{orgId} ────────────────────────────────────────────
    // Entidad de organización (nombre, slug, branding, reglamento, plan,
    // límites, billing). Lectura pública (branding/reglamento se muestran
    // en páginas públicas).
    // Escritura de campos sensibles (plan, billing, límites, status): solo
    // el Administrador de Plataforma.
    // Excepción acotada: el "organizador" de ESA organización puede editar
    // únicamente su propio branding y reglamento — nunca su plan/billing.
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isPlatformOwner()
        || (orgRole(orgId) == 'organizador' && onlyAffects(['branding', 'reglamento', 'updatedAt']));
    }

    // ── memberships/{uid}_{orgId} ────────────────────────────────────────
    // Documento espejo (para UI de gestión de equipo por organización) de
    // los custom claims org-scoped. La fuente de verdad real son los claims
    // del token, asignados solo por la Cloud Function `manage_user_role`
    // (Admin SDK, ignora estas reglas). El cliente NUNCA escribe aquí
    // directamente.
    match /memberships/{membershipId} {
      allow read: if isPlatformOwner()
        || (resource.data.orgId != null && isOrgAdmin(resource.data.orgId))
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Cualquier otra colección no contemplada explícitamente: denegada.
    // (incluye `userRoles`, legacy pre-Fase 2, ya vaciada y reemplazada por
    // `memberships` — ver scripts/cleanup-legacy-roles.js).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
