rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Reglas de seguridad — Fase 0 (roles) + Fase 1 (orgId, un solo tenant hoy)
//
// Reemplaza la ausencia total de reglas (antes, la única protección era
// JavaScript en el cliente: ADMIN_EMAILS hardcodeado). La fuente de verdad de
// los roles pasa a ser el Custom Claim del token de Firebase Auth
// (`admin: true` / `comisario: true`), asignado exclusivamente por la Cloud
// Function `manage_user_role` vía Admin SDK — nunca escrito directo por el
// cliente.
//
// Fase 1: los documentos de championships/events/teams(catálogo) llevan
// `orgId`, validado en create/update (inmutable tras crearse). Hoy solo
// existe una organización (`gt7-esp`, ver currentOrgId()) y los claims
// admin/comisario siguen siendo globales, no por-organización — eso es
// Fase 2 (memberships + claims org-scoped), deliberadamente diferida hasta
// que exista un segundo tenant real contra el cual validarla.
//
// Ver: Notas/Proyectos/GT7 Championships/02-ESPECIFICACIONES.md (SPEC-2, SPEC-5)
//      Notas/Proyectos/GT7 Championships/ADR/ADR-001-modelo-datos-multi-tenant.md
//      Notas/Proyectos/GT7 Championships/ADR/ADR-003-roles-permisos.md
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Un admin siempre cuenta como comisario también (mismo criterio que
    // hoy en AuthContext.isComisario()).
    function isComisario() {
      return isSignedIn() &&
        (request.auth.token.admin == true || request.auth.token.comisario == true);
    }

    function onlyAffects(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Administrador de Plataforma (dueño de trenkit) — por encima de todas
    // las organizaciones. Distinto de isAdmin() (admin global de GT7 ESP).
    // Solo se otorga una vez, vía script, nunca por el flujo normal de roles.
    function isPlatformOwner() {
      return isSignedIn() && request.auth.token.platformOwner == true;
    }

    // Fase 1 (multi-tenant, sin tenant routing todavía — ver ADR-001,
    // 02-ESPECIFICACIONES.md SPEC-2). Única organización hoy. Cuando exista
    // un segundo tenant real, esto se generaliza a validar contra
    // request.auth.token.orgs[orgId] en vez de una constante.
    function currentOrgId() {
      return 'gt7-esp';
    }

    // ── championships/{id} ───────────────────────────────────────────────
    // Documento principal: nombre, categorías, settings, drivers[],
    // registrations[], carUsageTracking, preQualy, divisionsConfig, etc.
    // Lectura pública (clasificaciones/calendario son páginas públicas).
    // Escritura de administración: solo admin.
    // Excepción: inscripción pública (RegistrationForm) solo puede tocar el
    // campo `registrations` — nunca settings, drivers, pointsSystem, etc.
    match /championships/{champId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.orgId == currentOrgId();
      // orgId es inmutable una vez creado: un admin puede editar cualquier
      // otro campo, pero no reasignar el documento a otra organización.
      allow update: if (isAdmin() && request.resource.data.orgId == resource.data.orgId)
        || onlyAffects(['registrations']);
      allow delete: if isAdmin();

      // Equipos, pistas, divisiones: gestión exclusiva de admin.
      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /tracks/{trackId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /divisions/{divId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /events/{subEventId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Sanciones y reclamaciones: gestionadas por admin o comisario.
      match /penalties/{penaltyId} {
        allow read: if true;
        allow write: if isComisario();
      }
      match /claims/{claimId} {
        allow read: if true;
        allow write: if isComisario();
      }
    }

    // ── events/{id} (eventos únicos, no ligados a un campeonato) ─────────
    // Lectura pública. Escritura de administración: solo admin.
    // Excepción: el flujo público de inscripción actualiza `waitlistCount`
    // y `updatedAt` en el doc principal, además de crear en las
    // subcolecciones `participants`/`waitlist` (sin sesión iniciada).
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.orgId == currentOrgId();
      allow update: if (isAdmin() && request.resource.data.orgId == resource.data.orgId)
        || onlyAffects(['waitlistCount', 'updatedAt']);
      allow delete: if isAdmin();

      match /participants/{participantId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
      match /waitlist/{entryId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
      match /results/{resultId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /rounds/{roundId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ── teams/{id} y tracks/{id} (catálogos globales, legacy) ────────────
    // Colecciones raíz independientes de los campeonatos: catálogo global de
    // equipos (`teamsAdmin`) y catálogo de circuitos con imagen reutilizable
    // entre campeonatos (`FirebaseService.getTracks()`, usado por
    // TrackFormModal). Lectura pública, escritura solo admin.
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.orgId == currentOrgId();
      allow update: if isAdmin() && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isAdmin();
    }
    // tracks NO se scopea por orgId a propósito — catálogo compartido entre
    // todas las organizaciones (ver 02-ESPECIFICACIONES.md SPEC-2).
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── organizations/{orgId} ────────────────────────────────────────────
    // Fase 1: entidad de organización (nombre, slug, branding, reglamento
    // propio, plan/límites, billing). Lectura pública (branding/reglamento
    // se muestran en páginas públicas). Escritura: solo el Administrador de
    // Plataforma — no cualquier admin global, para que un admin de GT7 ESP
    // no pueda tocar plan/billing/branding de otra organización. Cuando
    // exista el rol "Organizador" por-org (Fase 2), se sumará esa excepción
    // acotada a los campos de branding/reglamento de su propia organización.
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isPlatformOwner();
    }

    // ── userRoles/{emailDocId} ───────────────────────────────────────────
    // Documento espejo (para UI de /usersAdmin) de los custom claims.
    // La fuente de verdad real son los claims del token, asignados solo por
    // la Cloud Function `manage_user_role` (Admin SDK, ignora estas reglas).
    // El cliente NUNCA escribe aquí directamente — solo lectura por admin.
    match /userRoles/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cualquier otra colección no contemplada explícitamente: denegada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
