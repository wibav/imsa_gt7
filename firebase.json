{
  "functions": {
    "source": "functions",
    "runtime": "python312",
    "ignore": ["venv", "**/__pycache__", "**/*.pyc", "**/*.bak"]
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/convert_to_gt_svg",
        "function": "convert_to_gt_svg"
      },
      {
        "source": "/api/notify",
        "function": "notify"
      },
      {
        "source": "/api/manage-user-role",
        "function": "manage_user_role"
      },
      {
        "source": "/api/create-organization",
        "function": "create_organization"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    }
  }
}
